generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlserver"
}

model Area {
  id   Int    @id @default(autoincrement())
  name String @db.NVarChar(50)

  improvements Improvement[]

  @@map("area")
}

model Category {
  id             Int      @id @default(autoincrement())
  name           String   @db.NVarChar(50)
  categoryReward Decimal? @map("category_reward") @db.Decimal(10, 2)

  improvements Improvement[]

  @@map("category")
}

model Employee {
  id           Int     @id @default(autoincrement())
  name         String  @db.NVarChar(100)
  role         String  @default("OPERATOR")
  re           Int?    @unique(map: "UQ__EMPLOYEE__321433120B386ECD")
  shift        String? @db.NVarChar(20)
  passwordHash String  @map("password_hash") @db.NVarChar(100)

  improvementsChampion Improvement[] @relation("ChampionReviewImprovement")
  improvementsManager  Improvement[] @relation("ManagerReviewImprovement")
  suggestions          Suggestion[]

  @@map("employee")
}

model Improvement {
  id                      Int       @id(map: "PK__IMPROVEM__3213E83FFEE3890E") @default(autoincrement())
  description             String    @db.NVarChar(1000)
  status                  String    @default("DEFINE_MANAGER")
  categoryId              Int?      @map("category_id")
  areaId                  Int       @map("area_id")
  createdAt               DateTime  @map("created_at") @db.DateTime2
  adminReviewedAt         DateTime? @map("admin_reviewed_at") @db.DateTime2
  managerReviewedAt       DateTime? @map("manager_reviewed_at") @db.DateTime2
  championReviewedAt      DateTime? @map("champion_reviewed_at") @db.DateTime2
  implementationStartedAt DateTime? @map("implementation_started_at") @db.DateTime2
  completedAt             DateTime? @map("completed_at") @db.DateTime2
  managerId               Int?      @map("manager_id")
  championId              Int?      @map("champion_id")
  notes                   String?   @db.NVarChar(1000)
  rejectionNote           String?   @db.NVarChar(1000)

  area        Area         @relation(fields: [areaId], references: [id])
  category    Category?    @relation(fields: [categoryId], references: [id])
  champion    Employee?    @relation("ChampionReviewImprovement", fields: [championId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  manager     Employee?    @relation("ManagerReviewImprovement", fields: [managerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  suggestions Suggestion[]
}

model Payout {
  id           Int       @id @default(autoincrement())
  suggestionId Int       @map("suggestion_id")
  value        Decimal?  @db.Decimal(10, 2)
  status       String    @default("PENDING")
  createdAt    DateTime  @default(now()) @map("created_at") @db.DateTime2
  payedAt      DateTime? @map("payed_at") @db.DateTime2

  suggestion Suggestion @relation(fields: [suggestionId], references: [id])

  @@map("payout")
}

model Suggestion {
  id            Int @id @default(autoincrement())
  employeeId    Int @map("employee_id")
  improvementId Int @map("improvement_id")

  payout      Payout[]
  employee    Employee    @relation(fields: [employeeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  improvement Improvement @relation(fields: [improvementId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("suggestion")
}
