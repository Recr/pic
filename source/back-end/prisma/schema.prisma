generator client {
  provider = "prisma-client"
  output   = "../prisma/client"
}

datasource db {
  provider = "sqlserver"
}

model Area {
  id   Int    @id @default(autoincrement())
  name String @db.NVarChar(50)

  proposals Proposal[]

  @@map("area")
}

model Category {
  id             Int      @id @default(autoincrement())
  name           String   @db.NVarChar(50)
  categoryReward Decimal? @map("category_reward") @db.Decimal(10, 2)

  proposals Proposal[]

  @@map("category")
}

model Employee {
  id           Int     @id @default(autoincrement())
  name         String  @db.NVarChar(100)
  role         String  @default("OPERATOR")
  re           Int?    @unique
  shift        String? @db.NVarChar(20)
  passwordHash String  @map("password_hash") @db.NVarChar(100)
  mustChangePassword Boolean @map("must_change_password") @default(true)
  passwordToken String? @map("password_token") @db.NVarChar(100)

  proposalsChampion Proposal[]   @relation("ChampionReviewProposal")
  proposalsManager  Proposal[]   @relation("ManagerReviewProposal")
  suggestions       Suggestion[]
  refreshTokens     RefreshToken[]

  @@map("employee")
}

model Proposal {
  id                      Int       @id @default(autoincrement())
  description             String    @db.NVarChar(2000)
  status                  String    @db.NVarChar(100) @default("DEFINE_CHAMPION")
  categoryId              Int?      @map("category_id")
  rewardAmount            Decimal?  @map("reward_amount") @db.Decimal(10, 2)
  areaId                  Int       @map("area_id")
  createdAt               DateTime  @default(now()) @map("created_at") @db.DateTime2
  adminReviewedAt         DateTime? @map("admin_reviewed_at") @db.DateTime2
  managerReviewedAt       DateTime? @map("manager_reviewed_at") @db.DateTime2
  championReviewedAt      DateTime? @map("champion_reviewed_at") @db.DateTime2
  implementationStartedAt DateTime? @map("implementation_started_at") @db.DateTime2
  completedAt             DateTime? @map("completed_at") @db.DateTime2
  championId              Int?      @map("champion_id")
  notes                   String?   @db.NVarChar(1000)
  managerId               Int?      @map("manager_id")
  managerNotes            String?   @map("manager_notes") @db.NVarChar(1000)
  rejectionNote           String?   @map("rejection_note") @db.NVarChar(1000)
  isCustomReward          Boolean   @map("is_custom_reward") @default(false)
  isActive                Boolean   @map("is_active") @default(true)
  isLegacy                Boolean   @map("is_legacy") @default(false)


  area        Area         @relation(fields: [areaId], references: [id])
  category    Category?    @relation(fields: [categoryId], references: [id])
  champion    Employee?    @relation("ChampionReviewProposal", fields: [championId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  manager     Employee?    @relation("ManagerReviewProposal", fields: [managerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  suggestions Suggestion[]
  attachments ProposalAttachment[]

  @@map("proposal")
}

model Payout {
  id           Int       @id @default(autoincrement())
  suggestionId Int       @map("suggestion_id") @unique
  value        Decimal?  @db.Decimal(10, 2)
  status       String    @default("PENDING")
  createdAt    DateTime  @default(now()) @map("created_at") @db.DateTime2
  payedAt      DateTime? @map("payed_at") @db.DateTime2

  suggestion Suggestion @relation(fields: [suggestionId], references: [id])

  @@map("payout")
}

model Suggestion {
  id         Int @id @default(autoincrement())
  employeeId Int? @map("employee_id")
  proposalId Int @map("proposal_id")
  employeeRe Int @map("employee_re")
  employeeName String? @map("employee_name") @db.NVarChar(100)
  employeeShift String? @map("employee_shift") @db.NVarChar(20)

  payout   Payout[]
  employee Employee? @relation(fields: [employeeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  proposal Proposal @relation(fields: [proposalId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([employeeRe, proposalId])
  @@map("suggestion")
}

model RefreshToken {
  id         Int      @id @default(autoincrement())
  employeeId Int      @map("employee_id")
  tokenHash  String   @db.NVarChar(255)
  expiresAt  DateTime @map("expires_at") @db.DateTime2
  createdAt  DateTime @default(now()) @map("created_at") @db.DateTime2
  revokedAt  DateTime? @map("revoked_at") @db.DateTime2

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("refresh_token")
}

model ProposalAttachment {
  id          Int      @id @default(autoincrement())
  proposalId  Int      @map("proposal_id")
  relativePath    String   @map("relative_path") @db.NVarChar(255)
  storedName    String   @map("stored_name") @db.NVarChar(255)
  originalName String   @map("original_name") @db.NVarChar(255)
  sizeBytes   Int      @map("size_bytes")
  uploadedAt  DateTime @default(now()) @map("uploaded_at") @db.DateTime2

  proposal Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@map("proposal_attachment")
}

model AnnualTarget {
  id Int @id @default(autoincrement())
  annualSubmittedProposalsTarget Int @map("annual_submited_proposals_target")
  annualImplementedProposalsTarget Int @map("annual_implemented_proposals_target")
  annualHeadCount Int @map("annual_head_count")
  communicationDaysTarget Int @map("communication_days_target")
  year Int @map("year") @unique

  @@map("annual_target")
}

model CagysData {
  proposalId              Int?    
  description             String?   @db.NText
  re                      Float?    @db.Float
  EmployeeName            String?   @db.NVarChar(255)
  Shift                   String?   @db.NVarChar(255)
  Area                    String?   @db.NVarChar(255)
  category                String?   @db.NVarChar(255)
  Revisado                String?   @db.NVarChar(255)
  status                  String?   @db.NVarChar(255)
  date                    DateTime? @db.DateTime
  createdAt               DateTime? @db.DateTime
  ManagerName             String?   @db.NVarChar(255)
  rejectionNote           String?   @db.NVarChar(255)
  SuggestionCompletedAt   DateTime? @db.DateTime
  ChampionName            String?   @db.NVarChar(255)
  notes2                  String?   @db.NVarChar(255)
  notes1                  String?   @db.NVarChar(255)
  rejectionNote2          String?   @db.NVarChar(255)
  RejectedOrCompltedDate  DateTime? @db.DateTime
  championReviewedAt      DateTime? @db.DateTime
  PayoutAmount            Float?    @db.Float
  managerReviewedAt       DateTime? @db.DateTime
  adminReviewedAt         DateTime? @db.DateTime
  managerNotes            String?   @db.NVarChar(255)
  CompletedOrTodayDate    DateTime? @db.DateTime

  @@ignore
  @@map("cagysData")
}